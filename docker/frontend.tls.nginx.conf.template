# Фронт по HTTPS: включает docker-compose.tls.override.yml. Имя сертификата из окружения TLS_DOMAIN подставляет entrypoint
# образа nginx при старте, результат ложится на место /etc/nginx/conf.d/default.conf.
server {
    listen 80;
    # скрипт оценки по умолчанию шлёт на http://127.0.0.1:8080/v1/eval/predict и за редиректом не идёт
    if ($uri !~ ^/v1/eval/) {
        return 301 https://${TLS_DOMAIN}$request_uri;
    }
    include /etc/nginx/vinishko/site.conf;
}

server {
    listen 443 ssl;
    http2 on;
    ssl_certificate /etc/letsencrypt/live/${TLS_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${TLS_DOMAIN}/privkey.pem;
    include /etc/nginx/vinishko/site.conf;
}
