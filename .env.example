# Скопируйте в .env в корне проекта и заполните ключ.
# Запуск приложения: vinishko/README.md.
OPENROUTER_API_KEY=

# Proxy для запросов сомелье и whatis к OpenRouter; пустое значение — напрямую.
# Пример: http://127.0.0.1:8080
openrouter_http_proxy=

# Хранилище диалогов сомелье; путь относительно корня проекта.
SOMMELIER_DATA_DIR=vinishko/sommelier/data/sessions

# Ключ Qdrant: для docker compose обязателен, qdrant в нём поднимается с авторизацией.
# QDRANT_API_KEY=

# Реквизиты S3 Selectel: картинки коллекции и снапшоты qdrant. Локально boto3 берёт их и из ~/.aws,
# в docker compose они обязательны здесь.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Docker на GPU без -f в каждой команде.
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.override.yml

# Необязательно: сомелье и whatis могут читать ключ OpenRouter из файла.
# При заданном пути файл используется вместо OPENROUTER_API_KEY.
# OPENROUTER_API_KEY_FILE=C:/path/to/openrouter-key.txt

# Необязательно: заголовки запросов к OpenRouter.
# OPENROUTER_SITE_URL=http://localhost:8000
# OPENROUTER_APP_TITLE=Vinishko

# Устройства пайплайна задавайте в окружении до запуска основного API
# или в конфигурациях шагов. Значения: auto, cpu, cuda:0.
# $env:NORMALIZER_DEV='cuda:0'
# $env:VIS_SEARCHER_DEV='cuda:0'
