# Скопируйте в .env в корне проекта и заполните ключ.
# Запуск основного API и микросервисов: vinishko/app/README.md.
OPENROUTER_API_KEY=

# Proxy для запросов к OpenRouter; пустое значение — напрямую.
# Пример: http://127.0.0.1:8080
openrouter_http_proxy=

# Хранилище диалогов сомелье; путь относительно корня проекта.
SOMMELIER_DATA_DIR=vinishko/app/sommelier/data/sessions

# Необязательно: ключ Qdrant, если на сервере включена авторизация.
# QDRANT_API_KEY=

# Необязательно: микросервисы могут читать ключ OpenRouter из файла.
# При заданном пути файл используется вместо OPENROUTER_API_KEY.
# OPENROUTER_API_KEY_FILE=C:/path/to/openrouter-key.txt

# Необязательно: заголовки запросов к OpenRouter.
# OPENROUTER_SITE_URL=http://localhost:8000
# OPENROUTER_APP_TITLE=Vinishko

# Устройства пайплайна задавайте в окружении до запуска основного API
# или в конфигурациях шагов. Значения: auto, cpu, cuda:0.
# $env:NORMALIZER_DEV='cuda:0'
# $env:VIS_SEARCHER_DEV='cuda:0'
